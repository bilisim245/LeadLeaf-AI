# Bu dosyayi ".env" olarak kopyala ve degerleri doldur.

# --- Anthropic Claude (agent) ---
ANTHROPIC_API_KEY=sk-ant-buraya-yapistir
ANTHROPIC_MODEL=claude-sonnet-5

# --- Telegram botu ---
TELEGRAM_BOT_TOKEN=BotFather-in-verdigi-token

# --- Servisler ---
# Yerelde (Gradio/ui/app.py) calisirken bu deger yeterli. n8n Cloud'un inference'a
# ulasabilmesi icin ise bir tunel (ngrok vb.) veya public deploy URL'i gerekir —
# bkz. n8n/README_N8N.md. n8n workflow.json'daki URL'i AYRI olarak orada guncelle.
INFERENCE_URL=http://localhost:8000
# n8n Cloud'daki workflow'un webhook URL'i (n8n arayuzunden kopyalanir; local docker artik kullanilmiyor)
N8N_WEBHOOK_URL=

# --- Yerel Gradio demo arayuzu (ui/app.py) ---
GRADIO_PORT=7860

# --- Model dosyalari (Kaggle'dan iner) ---
MODEL_PATH=./model/model.keras
CLASS_NAMES_PATH=./model/class_names.json
# model_meta.json: {"mimari": "MobileNetV2"|"MobileNetV3Small"|"EfficientNetB0"} -
# hangi mimari model.keras ise dogru preprocess_input'u secmek icin (dosya yoksa
# MobileNetV2 varsayilir, eski tek-model akisiyla geriye donuk uyumlu).
MODEL_META_PATH=./model/model_meta.json

# --- TUBITAK 3-model karsilastirmasi (notebooks/01_train_model_colab.py ciktisi) ---
# leadleaf_tubitak_models.zip'in icindekileri bu klasore koy (3 .keras dosyasi +
# class_names.json + split_manifest.json + model_comparison.csv). Eksikse
# /predict_compare o model icin DEMO MODU'na duser, servis cokmez.
TUBITAK_MODEL_DIR=./model/tubitak

# --- Tarla defteri ---
DB_PATH=./bot/tarla_defteri.sqlite

# --- Karar esigi: bu degerin altinda "uzmana danis" ---
CONFIDENCE_THRESHOLD=0.70

# --- Hava durumu: Open-Meteo ucretsiz, anahtar GEREKMEZ ---

# Otomatik bitki tanima (Pl@ntNet, my.plantnet.org - ucretsiz plan 500 tanima/gun).
# Bos birakilirsa bitki sadece Telegram foto aciklamasindan okunur.
PLANTNET_API_KEY=
PLANTNET_MIN_SKOR=0.20
