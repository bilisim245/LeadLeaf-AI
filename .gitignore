# Ortam / gizli anahtarlar
.env
.venv/
venv/
__pycache__/
*.pyc

# Model dosyalari (buyuk, Kaggle/Colab'dan elle indirilip eklenir) - model/tubitak/
# dahil, alt klasorlerdekiler de kapsansin diye ** kullaniliyor
model/**/*.keras
model/**/*.h5
model/**/*.keras.bak

# RAG index'leri (uretilen dosyalar - build script'leriyle yeniden olusturulur)
rag/chroma_db/
rag/image_embeddings.npz

# Colab EDA ciktisi (00_veri_kesfi.py'den iner, buyuk PNG/veri) - .gitkeep haric
report/eda_ciktilari/*
!report/eda_ciktilari/.gitkeep

# Veritabani
*.sqlite
*.sqlite3

# n8n verisi
n8n/.n8n/

# Yerel test / log dosyalari
*.log
test_*.jpg
test_*.png

# Isletim sistemi / editor
.DS_Store
Thumbs.db
.vscode/

# Yerel veri seti kopyasi (sunum/veri analizi icin, GitHub spMohanty/PlantVillage-Dataset raw/color)
data/

# Grafik rehberi icin alinan pano ekran goruntuleri (PDF icinde zaten var)
sunum/ekran_goruntuleri/
